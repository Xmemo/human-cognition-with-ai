---
import Default from '@astrojs/starlight/components/Hero.astro';

const route = Astro.locals.starlightRoute;
const { data } = route.entry;
const isHomepage = route.id === '' || route.id === 'zh-cn';
const isZh = route.id === 'zh-cn';
const { title = data.title, tagline = '', actions = [] } = data.hero || {};

const axes = isZh
  ? [
      { index: '01', name: 'CONTROL', question: '关键认知节点由谁控制？', token: 'GOALS · VERIFY · JUDGE' },
      { index: '02', name: 'RETENTION', question: 'AI 离开后，人还保留什么？', token: 'EXPLAIN · TRANSFER · REPAIR' },
      { index: '03', name: 'VARIANCE', question: '群体还剩多少探索空间？', token: 'DIVERSITY · SEARCH · CULTURE' },
    ]
  : [
      { index: '01', name: 'CONTROL', question: 'Who controls the critical cognitive nodes?', token: 'GOALS · VERIFY · JUDGE' },
      { index: '02', name: 'RETENTION', question: 'What remains when AI is removed?', token: 'EXPLAIN · TRANSFER · REPAIR' },
      { index: '03', name: 'VARIANCE', question: 'How much collective search space remains?', token: 'DIVERSITY · SEARCH · CULTURE' },
    ];
---

{
  !isHomepage ? (
    <Default><slot /></Default>
  ) : (
    <section class="observatory-hero" data-observatory-hero>
      <div class="hero-copy">
        <div class="eyebrow">
          <span class="eyebrow-mark" aria-hidden="true"></span>
          <span>{isZh ? 'AI 时代人类认知研究观测站' : 'HUMAN COGNITION RESEARCH OBSERVATORY'}</span>
          <span class="eyebrow-code">CRV / 03</span>
        </div>

        <h1 id="_top" data-page-title set:html={title} />
        {tagline && <p class="hero-tagline" set:html={tagline} />}

        <p class="hero-thesis">
          {isZh
            ? '不只追踪 AI 让人做得更好还是更差，而是持续观察：哪些认知控制权被保留、哪些能力真正留下，以及群体搜索空间如何变化。'
            : 'We track more than whether AI improves output: which cognitive control points remain human, what capability survives after assistance, and how collective search space changes.'}
        </p>

        {actions.length > 0 && (
          <div class="hero-actions">
            {actions.map(({ link, text, variant }) => (
              <a class:list={['instrument-button', variant === 'minimal' && 'is-secondary']} href={link}>
                <span>{text}</span>
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M4 10h11M11 6l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" stroke-linejoin="miter" />
                </svg>
              </a>
            ))}
          </div>
        )}
      </div>

      <aside class="crv-instrument" aria-label={isZh ? 'Control、Retention、Variance 工作模型' : 'Control, Retention, Variance working model'}>
        <div class="instrument-head">
          <span>{isZh ? '工作模型' : 'WORKING MODEL'}</span>
          <span class="instrument-status"><i aria-hidden="true"></i>{isZh ? '证据持续更新' : 'EVIDENCE UPDATING'}</span>
        </div>

        <div class="axis-stack">
          {axes.map((axis) => (
            <div class="axis-row">
              <div class="axis-index">{axis.index}</div>
              <div class="axis-copy">
                <strong>{axis.name}</strong>
                <span>{axis.question}</span>
                <small>{axis.token}</small>
              </div>
              <div class="axis-mark" aria-hidden="true">
                <span></span><span></span><span></span><span></span><span></span>
              </div>
            </div>
          ))}
        </div>

        <div class="instrument-foot">
          <span>PERSON</span>
          <span class="flow-line" aria-hidden="true"></span>
          <span>SYSTEM</span>
          <span class="flow-line" aria-hidden="true"></span>
          <span>CULTURE</span>
        </div>
      </aside>
    </section>
  )
}
