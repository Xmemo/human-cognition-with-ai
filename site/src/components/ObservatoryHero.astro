---
import Default from '@astrojs/starlight/components/Hero.astro';
import CognitiveField from './CognitiveField.astro';

const route = Astro.locals.starlightRoute;
const { data } = route.entry;
const isHomepage = route.id === '' || route.id === 'zh-cn';
const isZh = route.id === 'zh-cn';
const { title = data.title, tagline = '', actions = [] } = data.hero || {};
---

{
  !isHomepage ? (
    <Default><slot /></Default>
  ) : (
    <section class="observatory-hero" data-observatory-hero>
      <div class="hero-copy">
        <div class="eyebrow">
          <span class="eyebrow-mark" aria-hidden="true"></span>
          <span>{isZh ? 'AI 时代人类认知研究观测站' : 'HUMAN COGNITION RESEARCH OBSERVATORY'}</span>
          <span class="eyebrow-code">FIELD / LIVE</span>
        </div>

        <h1 id="_top" data-page-title set:html={title} />
        {tagline && <p class="hero-tagline" set:html={tagline} />}

        <p class="hero-thesis">
          {isZh
            ? '我们关注的不只是 AI 让结果变好还是变差，而是人的认知控制、真正保留下来的能力，以及这些变化如何扩散到群体与文化。'
            : 'We track more than whether AI improves output: how human cognitive control, retained capability, and collective search change as intelligence becomes increasingly external.'}
        </p>

        {actions.length > 0 && (
          <div class="hero-actions">
            {actions.map(({ link, text, variant }) => (
              <a class:list={['instrument-button', variant === 'minimal' && 'is-secondary']} href={link}>
                <span>{text}</span>
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M4 10h11M11 6l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" stroke-linejoin="miter" />
                </svg>
              </a>
            ))}
          </div>
        )}
      </div>

      <CognitiveField />
    </section>
  )
}
