---
// Decorative hero visualization. It deliberately carries no research claim:
// the visual suggests a changing field of relationships rather than encoding
// Control / Retention / Variance as if they were measured live variables.
---

<div class="cognitive-field" data-cognitive-field aria-hidden="true">
  <div class="field-frame">
    <svg viewBox="0 0 620 520" role="presentation">
      <defs>
        <radialGradient id="nodeBlue" cx="50%" cy="50%" r="50%">
          <stop offset="0" stop-color="#dbe8ff" />
          <stop offset="0.28" stop-color="#75a7ff" />
          <stop offset="1" stop-color="#245fdb" stop-opacity="0" />
        </radialGradient>
        <radialGradient id="nodeGreen" cx="50%" cy="50%" r="50%">
          <stop offset="0" stop-color="#d8fff1" />
          <stop offset="0.3" stop-color="#68d6a7" />
          <stop offset="1" stop-color="#68d6a7" stop-opacity="0" />
        </radialGradient>
        <radialGradient id="nodeWarm" cx="50%" cy="50%" r="50%">
          <stop offset="0" stop-color="#ffe5d8" />
          <stop offset="0.3" stop-color="#e57a52" />
          <stop offset="1" stop-color="#d75a35" stop-opacity="0" />
        </radialGradient>
        <linearGradient id="linkGradient" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#68d6a7" stop-opacity="0.08" />
          <stop offset="0.5" stop-color="#7caaff" stop-opacity="0.72" />
          <stop offset="1" stop-color="#d75a35" stop-opacity="0.08" />
        </linearGradient>
        <filter id="softGlow" x="-60%" y="-60%" width="220%" height="220%">
          <feGaussianBlur stdDeviation="8" />
        </filter>
        <filter id="wideGlow" x="-80%" y="-80%" width="260%" height="260%">
          <feGaussianBlur stdDeviation="22" />
        </filter>
      </defs>

      <g class="field-grid">
        <circle cx="310" cy="258" r="92" />
        <circle cx="310" cy="258" r="166" />
        <circle cx="310" cy="258" r="232" />
        <path d="M52 258H568M310 20V496" />
        <path d="M126 74L494 442M494 74L126 442" />
      </g>

      <g class="field-haze" filter="url(#wideGlow)">
        <circle cx="304" cy="252" r="98" fill="#245fdb" opacity="0.16" />
        <circle cx="438" cy="330" r="70" fill="#68d6a7" opacity="0.08" />
        <circle cx="196" cy="182" r="62" fill="#d75a35" opacity="0.07" />
      </g>

      <g class="network network-a">
        <path class="link link-1" d="M110 318 Q202 230 292 260 T504 184" />
        <path class="link link-2" d="M154 134 Q258 216 310 258 T470 374" />
        <path class="link link-3" d="M104 390 Q210 344 310 258 T528 320" />
        <path class="link link-4" d="M222 94 Q270 178 310 258 T382 448" />
        <path class="link link-5" d="M78 232 Q198 246 310 258 T548 250" />
      </g>

      <g class="network network-b">
        <path class="link faint" d="M154 134 L110 318 L104 390" />
        <path class="link faint" d="M222 94 L504 184 L548 250 L528 320 L470 374 L382 448" />
        <path class="link faint" d="M154 134 Q308 70 504 184" />
        <path class="link faint" d="M104 390 Q310 488 470 374" />
      </g>

      <g class="signal-streams">
        <circle class="signal signal-blue s1" r="3.5"><animateMotion dur="5.8s" repeatCount="indefinite" path="M110 318 Q202 230 292 260 T504 184" /></circle>
        <circle class="signal signal-green s2" r="3"><animateMotion dur="7.4s" repeatCount="indefinite" begin="-2.1s" path="M104 390 Q210 344 310 258 T528 320" /></circle>
        <circle class="signal signal-warm s3" r="3"><animateMotion dur="6.6s" repeatCount="indefinite" begin="-4.2s" path="M222 94 Q270 178 310 258 T382 448" /></circle>
      </g>

      <g class="node-layer node-layer-far">
        <g class="node node-small" transform="translate(78 232)"><circle class="halo blue" r="21"/><circle class="core" r="4.5"/></g>
        <g class="node node-small" transform="translate(548 250)"><circle class="halo green" r="20"/><circle class="core" r="4"/></g>
        <g class="node node-small" transform="translate(222 94)"><circle class="halo warm" r="20"/><circle class="core" r="4"/></g>
        <g class="node node-small" transform="translate(382 448)"><circle class="halo blue" r="20"/><circle class="core" r="4"/></g>
      </g>

      <g class="node-layer node-layer-mid">
        <g class="node" transform="translate(154 134)"><circle class="halo warm" r="31"/><circle class="ring" r="12"/><circle class="core" r="5.5"/></g>
        <g class="node" transform="translate(110 318)"><circle class="halo green" r="34"/><circle class="ring" r="13"/><circle class="core" r="5.5"/></g>
        <g class="node" transform="translate(104 390)"><circle class="halo blue" r="30"/><circle class="ring" r="11"/><circle class="core" r="5"/></g>
        <g class="node" transform="translate(504 184)"><circle class="halo blue" r="36"/><circle class="ring" r="13"/><circle class="core" r="6"/></g>
        <g class="node" transform="translate(528 320)"><circle class="halo green" r="34"/><circle class="ring" r="12"/><circle class="core" r="5.5"/></g>
        <g class="node" transform="translate(470 374)"><circle class="halo warm" r="31"/><circle class="ring" r="11"/><circle class="core" r="5"/></g>
      </g>

      <g class="central-system" transform="translate(310 258)">
        <circle class="central-orbit orbit-a" r="48" />
        <circle class="central-orbit orbit-b" r="67" />
        <circle class="central-halo" r="54" fill="url(#nodeBlue)" filter="url(#softGlow)" />
        <circle class="central-ring" r="25" />
        <circle class="central-ring inner" r="13" />
        <circle class="central-core" r="6.5" />
        <g class="satellite-orbit">
          <circle cx="48" cy="0" r="3.5" class="satellite" />
        </g>
      </g>

      <g class="ambient-particles">
        <circle cx="62" cy="102" r="1.3" />
        <circle cx="186" cy="420" r="1.1" />
        <circle cx="566" cy="108" r="1.2" />
        <circle cx="452" cy="72" r="1.1" />
        <circle cx="562" cy="416" r="1.2" />
        <circle cx="268" cy="468" r="1.1" />
        <circle cx="72" cy="358" r="1" />
      </g>
    </svg>
    <div class="scan-line"></div>
    <div class="corner c1"></div><div class="corner c2"></div><div class="corner c3"></div><div class="corner c4"></div>
  </div>
</div>

<script is:inline>
  (() => {
    const fields = document.querySelectorAll('[data-cognitive-field]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) return;
    fields.forEach((field) => {
      const reset = () => {
        field.style.setProperty('--field-rx', '0deg');
        field.style.setProperty('--field-ry', '0deg');
        field.style.setProperty('--field-x', '0px');
        field.style.setProperty('--field-y', '0px');
      };
      field.addEventListener('pointermove', (event) => {
        const rect = field.getBoundingClientRect();
        const x = (event.clientX - rect.left) / rect.width - 0.5;
        const y = (event.clientY - rect.top) / rect.height - 0.5;
        field.style.setProperty('--field-rx', `${(-y * 5).toFixed(2)}deg`);
        field.style.setProperty('--field-ry', `${(x * 7).toFixed(2)}deg`);
        field.style.setProperty('--field-x', `${(x * 8).toFixed(2)}px`);
        field.style.setProperty('--field-y', `${(y * 8).toFixed(2)}px`);
      }, { passive: true });
      field.addEventListener('pointerleave', reset, { passive: true });
    });
  })();
</script>

<style>
  .cognitive-field {
    --field-rx: 0deg;
    --field-ry: 0deg;
    --field-x: 0px;
    --field-y: 0px;
    position: relative;
    z-index: 1;
    width: min(100%, 40rem);
    margin-inline: auto;
    perspective: 900px;
  }

  .field-frame {
    position: relative;
    aspect-ratio: 1.16 / 1;
    overflow: hidden;
    border: 1px solid rgba(122, 151, 181, 0.3);
    border-radius: 0.35rem;
    background:
      radial-gradient(circle at 50% 48%, rgba(61, 107, 190, 0.12), transparent 42%),
      linear-gradient(145deg, rgba(9, 17, 25, 0.92), rgba(12, 24, 35, 0.68));
    box-shadow:
      inset 0 0 0 1px rgba(255,255,255,0.018),
      0 2rem 6rem rgba(0,0,0,0.28);
    transform: rotateX(var(--field-rx)) rotateY(var(--field-ry)) translate3d(var(--field-x), var(--field-y), 0);
    transform-style: preserve-3d;
    transition: transform 180ms ease-out;
  }

  .field-frame::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgba(116,159,211,0.035) 1px, transparent 1px),
      linear-gradient(rgba(116,159,211,0.035) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(circle at center, black 25%, transparent 86%);
  }

  svg {
    display: block;
    width: 100%;
    height: 100%;
    transform: translateZ(12px) scale(1.015);
  }

  .field-grid {
    fill: none;
    stroke: #6f8ca7;
    stroke-width: 0.7;
    opacity: 0.12;
  }

  .link {
    fill: none;
    stroke: url(#linkGradient);
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-dasharray: 5 8;
    animation: linkFlow 16s linear infinite;
  }

  .link.faint { opacity: 0.24; stroke-width: 0.8; stroke-dasharray: 2 10; }
  .link-2 { animation-duration: 19s; animation-direction: reverse; }
  .link-3 { animation-duration: 13s; }
  .link-4 { animation-duration: 21s; animation-direction: reverse; }
  .link-5 { animation-duration: 15s; }

  .network-a { animation: driftA 11s ease-in-out infinite alternate; transform-origin: center; }
  .network-b { animation: driftB 14s ease-in-out infinite alternate; transform-origin: center; }
  .node-layer-mid { animation: driftB 12s ease-in-out infinite alternate-reverse; transform-origin: center; }
  .node-layer-far { animation: driftA 17s ease-in-out infinite alternate; transform-origin: center; }

  .halo { opacity: 0.72; }
  .halo.blue { fill: url(#nodeBlue); }
  .halo.green { fill: url(#nodeGreen); }
  .halo.warm { fill: url(#nodeWarm); }
  .ring { fill: none; stroke: rgba(190,214,239,0.38); stroke-width: 0.9; }
  .core { fill: #edf5fb; filter: drop-shadow(0 0 5px rgba(182,216,255,0.8)); }
  .node:nth-child(2n) .core { animation: nodePulse 3.8s ease-in-out infinite; }
  .node:nth-child(3n) .core { animation: nodePulse 4.6s ease-in-out infinite reverse; }

  .central-system { transform-box: fill-box; transform-origin: center; }
  .central-orbit { fill: none; stroke: rgba(121,162,211,0.22); stroke-width: 0.8; stroke-dasharray: 3 8; }
  .orbit-a { animation: orbitDash 18s linear infinite; }
  .orbit-b { animation: orbitDash 28s linear infinite reverse; }
  .central-ring { fill: rgba(12,22,32,0.92); stroke: #5e8bdc; stroke-width: 1.1; }
  .central-ring.inner { fill: none; stroke: rgba(104,214,167,0.6); }
  .central-core { fill: #eef6ff; filter: drop-shadow(0 0 9px rgba(106,162,255,0.95)); animation: centralPulse 3s ease-in-out infinite; }
  .central-halo { opacity: 0.58; animation: haloBreath 4.5s ease-in-out infinite; }
  .satellite-orbit { animation: spin 9s linear infinite; transform-box: fill-box; transform-origin: center; }
  .satellite { fill: #68d6a7; filter: drop-shadow(0 0 5px rgba(104,214,167,0.9)); }

  .signal { filter: drop-shadow(0 0 6px currentColor); }
  .signal-blue { fill: #8bb3ff; color: #8bb3ff; }
  .signal-green { fill: #79e0b7; color: #79e0b7; }
  .signal-warm { fill: #f08a62; color: #f08a62; }

  .ambient-particles { fill: #b6cee4; opacity: 0.48; animation: particleTwinkle 5s ease-in-out infinite alternate; }

  .scan-line {
    position: absolute;
    z-index: 3;
    top: -12%;
    left: 5%;
    width: 90%;
    height: 1px;
    pointer-events: none;
    background: linear-gradient(90deg, transparent, rgba(104,214,167,0.18), rgba(114,165,255,0.42), rgba(104,214,167,0.18), transparent);
    box-shadow: 0 0 16px rgba(90,143,232,0.17);
    animation: scan 7.8s linear infinite;
  }

  .corner { position: absolute; z-index: 4; width: 1.1rem; height: 1.1rem; border-color: rgba(104,214,167,0.55); pointer-events: none; }
  .c1 { top: 0.65rem; left: 0.65rem; border-top: 1px solid; border-left: 1px solid; }
  .c2 { top: 0.65rem; right: 0.65rem; border-top: 1px solid; border-right: 1px solid; }
  .c3 { bottom: 0.65rem; left: 0.65rem; border-bottom: 1px solid; border-left: 1px solid; }
  .c4 { bottom: 0.65rem; right: 0.65rem; border-bottom: 1px solid; border-right: 1px solid; }

  @keyframes linkFlow { to { stroke-dashoffset: -130; } }
  @keyframes orbitDash { to { stroke-dashoffset: -180; } }
  @keyframes driftA { from { transform: translate(-4px, 4px) scale(0.995); } to { transform: translate(5px, -5px) scale(1.012); } }
  @keyframes driftB { from { transform: translate(4px, -3px); } to { transform: translate(-5px, 5px); } }
  @keyframes nodePulse { 0%,100% { opacity: 0.72; } 50% { opacity: 1; } }
  @keyframes centralPulse { 0%,100% { opacity: 0.78; } 50% { opacity: 1; } }
  @keyframes haloBreath { 0%,100% { opacity: 0.38; transform: scale(0.94); } 50% { opacity: 0.7; transform: scale(1.08); } }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes scan { 0% { transform: translateY(0); opacity: 0; } 8% { opacity: 1; } 88% { opacity: 0.7; } 100% { transform: translateY(34rem); opacity: 0; } }
  @keyframes particleTwinkle { from { opacity: 0.24; } to { opacity: 0.58; } }

  @media (max-width: 68rem) {
    .cognitive-field { width: min(100%, 34rem); }
  }

  @media (max-width: 50rem) {
    .cognitive-field { width: min(100%, 31rem); margin-top: 0.5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .field-frame { transform: none !important; transition: none; }
    .network-a, .network-b, .node-layer-mid, .node-layer-far,
    .link, .node .core, .central-core, .central-halo, .central-orbit,
    .satellite-orbit, .scan-line, .ambient-particles { animation: none !important; }
    .scan-line { display: none; }
  }
</style>
